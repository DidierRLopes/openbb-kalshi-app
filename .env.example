# All settings are optional - the app ships with working defaults.
# Copy this file to .env to override them.

# Kalshi public market-data base URL. The api.elections.kalshi.com and
# external-api.kalshi.com hosts are interchangeable.
KALSHI_API_BASE_URL=https://api.elections.kalshi.com/trade-api/v2

# Browser-facing backend base URL. Leave empty to infer it from each request.
KALSHI_PUBLIC_BASE_URL=

# HTTP request timeout (seconds).
KALSHI_HTTP_TIMEOUT=20

# Shared upstream request rate limit (requests per second).
KALSHI_RATE_LIMIT_PER_SEC=8

# On-disk diskcache location. Point this at a mounted volume in production so the
# cache survives restarts and never grows in RAM. Holds an `http/` response cache
# and a durable `data/` taxonomy + market snapshot.
KALSHI_CACHE_DIR=./.cache
KALSHI_HTTP_CACHE_SIZE_LIMIT_MB=256   # size cap for the volatile HTTP response cache

# Cache time-to-live (seconds), split by how fast each data class changes.
KALSHI_QUOTE_TTL_SECONDS=30      # markets, events
KALSHI_REALTIME_TTL_SECONDS=10   # order book, latest trades
KALSHI_TAXONOMY_TTL_SECONDS=600  # series catalog + category/tag taxonomy

# Market ingest: a single background task pages the full open-market book into
# the disk snapshot, paced to avoid CPU/RAM spikes in the container.
KALSHI_STATS_TTL_SECONDS=1800         # how often the snapshot is refreshed
KALSHI_STATS_SCAN_MAX_PAGES=200       # safety ceiling on 1000-market pages per scan
KALSHI_STATS_PAGE_PAUSE_SECONDS=0.25  # pause between pages to spread the ingest load
