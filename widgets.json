  "events_table": {
    "name": "Event Discovery",
    "description": "Browse Kalshi events by human-readable name. Filter by available category and regex before the row limit is applied, then click an event name to update the rest of the dashboard.",
    "category": "Kalshi",
    "type": "table",
    "endpoint": "events_table",
    "gridData": {
      "w": 26,
      "h": 22
    },
    "source": [
      "Kalshi"
    ],
    "params": [
      {
        "paramName": "status",
        "type": "text",
        "label": "Status",
        "value": "open",
        "options": [
          {
            "label": "Open",
            "value": "open"
          },
          {
            "label": "Unopened",
            "value": "unopened"
          },
          {
            "label": "Closed",
            "value": "closed"
          },
          {
            "label": "Settled",
            "value": "settled"
          },
          {
            "label": "All",
            "value": "all"
          }
        ]
      },
      {
        "paramName": "category",
        "type": "endpoint",
        "label": "Category",
        "optionsEndpoint": "/event_category_options",
        "optionsParams": {
          "status": "$status"
        },
        "value": "All"
      },
      {
        "paramName": "limit",
        "type": "number",
        "label": "Limit",
        "value": 100
      },
      {
        "paramName": "search_regex",
        "type": "text",
        "label": "Search Regex",
        "placeholder": "election|fed|weather",
        "value": ""
      },
      {
        "paramName": "event_ticker",
        "type": "endpoint",
        "label": "Event",
        "optionsEndpoint": "/event_options",
        "value": "KXELONMARS-99",
        "show": false
      }
    ],
    "data": {
      "table": {
        "showAll": true,
        "enableCharts": true,
        "columnsDefs": [
          {
            "field": "title",
            "headerName": "Event",
            "cellDataType": "text",
            "chartDataType": "category",
            "pinned": "left",
            "width": 420,
            "renderFn": "cellOnClick",
            "renderFnParams": {
              "actionType": "groupBy",
              "groupBy": {
                "paramName": "event_ticker",
                "valueField": "event_ticker"
              }
            }
          },
          {
            "field": "category",
            "headerName": "Category",
            "cellDataType": "text",
            "chartDataType": "category",
            "width": 170
          },
          {
            "field": "subtitle",
            "headerName": "Subtitle",
            "cellDataType": "text",
            "width": 220
          },
          {
            "field": "event_ticker",
            "headerName": "Event Ticker",
            "cellDataType": "text",
            "chartDataType": "category",
            "width": 220
          },
          {
            "field": "series_ticker",
            "headerName": "Series",
            "cellDataType": "text",
            "chartDataType": "category",
            "width": 150
          },
          {
            "field": "mutually_exclusive",
            "headerName": "Mutually Exclusive",
            "cellDataType": "boolean",
            "width": 150
          },
          {
            "field": "available_on_brokers",
            "headerName": "Broker Available",
            "cellDataType": "boolean",
            "width": 150
          },
          {
            "field": "last_updated",
            "headerName": "Last Updated",
            "cellDataType": "dateString",
            "chartDataType": "category",
            "width": 170
          }
        ]
