{
  "volume_by_category": {
    "name": "24h Volume by Category / Tag",
    "description": "Aggregated open-market activity grouped by Kalshi category or tag. Toggle the metric (24h volume, open interest, total volume) and restrict to markets resolving within a window.",
    "category": "Kalshi",
    "type": "chart",
    "endpoint": "volume_by_category",
    "raw": true,
    "gridData": {
      "w": 40,
      "h": 20
    },
    "source": [
      "Kalshi"
    ],
    "params": [
      {
        "paramName": "category",
        "type": "endpoint",
        "label": "Category",
        "optionsEndpoint": "/options",
        "optionsParams": {
          "field": "category"
        },
        "value": "All",
        "show": true
      },
      {
        "paramName": "group_by",
        "type": "text",
        "label": "Group By",
        "value": "category",
        "options": [
          {
            "label": "Category",
            "value": "category"
          },
          {
            "label": "Tag",
            "value": "tag"
          }
        ]
      },
      {
        "paramName": "metric",
        "type": "text",
        "label": "Metric",
        "value": "volume_24h",
        "options": [
          {
            "label": "24h Volume",
            "value": "volume_24h"
          },
          {
            "label": "Open Interest",
            "value": "open_interest"
          },
          {
            "label": "Total Volume",
            "value": "volume_total"
          }
        ]
      },
      {
        "paramName": "tag",
        "type": "endpoint",
        "label": "Tag",
        "optionsEndpoint": "/options",
        "value": "All",
        "show": true,
        "optionsParams": {
          "field": "tag",
          "category": "$category"
        }
      },
      {
        "paramName": "close_within",
        "type": "text",
        "label": "Closes Within",
        "value": "",
        "options": [
          {
            "label": "Any time",
            "value": ""
          },
          {
            "label": "24 hours",
            "value": "1"
          },
          {
            "label": "7 days",
            "value": "7"
          },
          {
            "label": "30 days",
            "value": "30"
          },
          {
            "label": "90 days",
            "value": "90"
          }
        ]
      }
    ]
  },
